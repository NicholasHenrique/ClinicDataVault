# Copie este arquivo para ".env" e preencha com seus próprios valores.
# O ".env" nunca é versionado (veja .gitignore).

# --- Google Cloud ---
GCP_PROJECT_ID=
GCS_BUCKET_NAME=clinic-datavault
RAW_PREFIX=raw

# Caminho para a chave da service account "clinic-uploader".
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/.../.gcp-keys/clinic-uploader-key.json

# --- Geração de dados sintéticos ---
LOCAL_OUTPUT_DIR=data/raw
SEED=42
N_PACIENTES=300
N_PROFISSIONAIS=40
N_UNIDADES=5
N_CONVENIOS=15
N_CONSULTAS=1500