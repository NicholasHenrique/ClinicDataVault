# Copy this file to ".env" and fill in your own values.
# ".env" is never committed (see .gitignore).

# --- Google Cloud ---
GCP_PROJECT_ID=
GCS_BUCKET_NAME=clinic-datavault
RAW_PREFIX=raw

# Path to the "clinic-uploader" service account key.
# Recommended: keep the file OUTSIDE this repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/.../.gcp-keys/clinic-uploader-key.json

# --- Synthetic data generation ---
LOCAL_OUTPUT_DIR=data/raw
SEED=42
N_PATIENTS=300
N_PRACTITIONERS=40
N_FACILITIES=5
N_INSURANCE_PROVIDERS=15
N_APPOINTMENTS=1500

# Second/third source simulation (multi-source Raw Vault integration)
N_PARTNER_PATIENTS_NEW=40
PARTNER_OVERLAP_RATE=0.6
FEEDBACK_RATE=0.3